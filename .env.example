# Copy to .env and fill in real values.
DATABASE_URL="file:./dev.db"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""
DOCUMENT_STORAGE_DIR="./storage/documents"
# Session cookies default to Secure in production (NODE_ENV=production), which
# a browser silently refuses to store over a plain-HTTP connection. Only set
# this to "false" if this deployment genuinely has no TLS/domain in front of
# it (e.g. an IP-only demo box) — leave unset for any real HTTPS deployment.
# COOKIE_SECURE="false"
